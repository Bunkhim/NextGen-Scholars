# Copy this file to keystore.properties and fill in your real credentials.
# keystore.properties is gitignored and must NEVER be committed.
#
# storeFile is relative to the android/app module directory.
# Alternatively, set these as environment variables (KEYSTORE_STORE_FILE,
# KEYSTORE_STORE_PASSWORD, KEYSTORE_KEY_ALIAS, KEYSTORE_KEY_PASSWORD) which
# take precedence when keystore.properties is absent.
storeFile=upload-keystore.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me
